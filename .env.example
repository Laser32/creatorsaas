# ===================================
# CreatorSaaS – Environment Variables
# ===================================

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=creatorsaas
POSTGRES_USER=creatorsaas
POSTGRES_PASSWORD=your_strong_password_here
CONNECTION_STRING=Host=localhost;Port=5432;Database=creatorsaas;Username=creatorsaas;Password=your_strong_password_here

# --- Redis ---
REDIS_CONNECTION=localhost:6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ISSUER=CreatorSaaS
JWT_AUDIENCE=CreatorSaaS-Clients
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_AGENCY=price_agency_id

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# --- Anthropic (alternative to OpenAI) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-4-6

# --- AI Provider: "openai" or "anthropic" ---
AI_PROVIDER=openai

# --- ElevenLabs ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Pexels ---
PEXELS_API_KEY=your_pexels_api_key

# --- YouTube ---
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/oauth/youtube/callback

# --- Storage (local or S3) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/storage
AWS_S3_BUCKET=creatorsaas-media
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=eu-central-1

# --- FFmpeg ---
FFMPEG_PATH=/usr/bin/ffmpeg

# --- Hangfire ---
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASSWORD=your_hangfire_password

# --- Email (SendGrid or SMTP) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@creatorsaas.io

# --- Sentry (optional) ---
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
