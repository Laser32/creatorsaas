# Build stage
FROM node:20-alpine AS builder
WORKDIR /app

COPY src/CreatorSaaS.Frontend/package*.json ./
RUN npm ci

COPY src/CreatorSaaS.Frontend ./
RUN npm run build

# Runtime stage
FROM node:20-alpine
WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/dist ./dist

ENV PORT=3000
EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]
